diff --git a/src/infrastructure/repositories/ownersapp/dashboardRepo.js b/src/infrastructure/repositories/ownersapp/dashboardRepo.js
new file mode 100644
index 0000000..2212ceb
--- /dev/null
+++ b/src/infrastructure/repositories/ownersapp/dashboardRepo.js
@@ -0,0 +1,116 @@
+import paymentModel from "../../models/chit/paymentModel.js";
+import customerModel from "../../models/chit/customerModel.js";
+
+class DashboardRepo {
+    async getDashboardStats(fromDate, toDate) {
+        const now = new Date();
+        const startOfDay = new Date(now.setHours(0, 0, 0, 0));
+        const endOfDay = new Date(now.setHours(23, 59, 59, 999));
+
+        let queryFromDate = startOfDay;
+        if (fromDate && !isNaN(new Date(fromDate).getTime())) {
+            queryFromDate = new Date(fromDate);
+        }
+
+        let queryToDate = endOfDay;
+        if (toDate && !isNaN(new Date(toDate).getTime())) {
+            queryToDate = new Date(toDate);
+        }
+
+        const [paymentStatsResult, customerStatsResult] = await Promise.all([
+            paymentModel.aggregate([
+                {
+                    $match: {
+                        date_payment: { $gte: queryFromDate, $lte: queryToDate },
+                        payment_status: 1,
+                        active: true,
+                        is_deleted: false
+                    }
+                },
+                {
+                    $lookup: {
+                        from: "schemes",
+                        localField: "id_scheme",
+                        foreignField: "_id",
+                        as: "schemeInfo"
+                    }
+                },
+                { $unwind: { path: "$schemeInfo", preserveNullAndEmptyArrays: true } },
+                {
+                    $lookup: {
+                        from: "metals",
+                        localField: "schemeInfo.id_metal",
+                        foreignField: "_id",
+                        as: "metalInfo"
+                    }
+                },
+                { $unwind: { path: "$metalInfo", preserveNullAndEmptyArrays: true } },
+                {
+                    $group: {
+                        _id: null,
+                        totalAmount: { $sum: "$payment_amount" },
+                        goldSavings: {
+                            $sum: {
+                                $cond: [
+                                    { $gte: [{ $indexOfBytes: [{ $ifNull: [{ $toLower: "$metalInfo.metal_name" }, ""] }, "gold"] }, 0] },
+                                    { $ifNull: ["$metal_weight", 0] },
+                                    0
+                                ]
+                            }
+                        },
+                        silverSavings: {
+                            $sum: {
+                                $cond: [
+                                    { $gte: [{ $indexOfBytes: [{ $ifNull: [{ $toLower: "$metalInfo.metal_name" }, ""] }, "silver"] }, 0] },
+                                    { $ifNull: ["$metal_weight", 0] },
+                                    0
+                                ]
+                            }
+                        }
+                    }
+                }
+            ]),
+            customerModel.aggregate([
+                {
+                    $match: {
+                        createdAt: { $lte: queryToDate },
+                        active: true,
+                        is_deleted: false
+                    }
+                },
+                {
+                    $group: {
+                        _id: null,
+                        totalCustomers: { $sum: 1 },
+                        newJoiners: {
+                            $sum: {
+                                $cond: [
+                                    { $gte: ["$createdAt", queryFromDate] },
+                                    1,
+                                    0
+                                ]
+                            }
+                        }
+                    }
+                }
+            ])
+        ]);
+
+        const paymentStats = paymentStatsResult[0] || { totalAmount: 0, goldSavings: 0, silverSavings: 0 };
+        const customerStats = customerStatsResult[0] || { totalCustomers: 0, newJoiners: 0 };
+
+        return {
+            dateRange: {
+                fromDate: queryFromDate,
+                toDate: queryToDate
+            },
+            totalPayments: paymentStats.totalAmount,
+            totalCustomers: customerStats.totalCustomers,
+            newJoiners: customerStats.newJoiners,
+            goldSavings: paymentStats.goldSavings,
+            silverSavings: paymentStats.silverSavings
+        };
+    }
+}
+
+export default DashboardRepo;
diff --git a/src/interfaces/controllers/ownersapp/dashboardController.js b/src/interfaces/controllers/ownersapp/dashboardController.js
new file mode 100644
index 0000000..d81180b
--- /dev/null
+++ b/src/interfaces/controllers/ownersapp/dashboardController.js
@@ -0,0 +1,19 @@
+import asyncHandler from '../../../utils/errors/asyncHandler.js';
+
+class DashboardController {
+    constructor(dashboardUseCase) {
+        this.dashboardUseCase = dashboardUseCase;
+    }
+
+    getDashboard = asyncHandler(async (req, res) => {
+        const { fromDate, toDate } = req.query;
+        const data = await this.dashboardUseCase.executeGetDashboard(fromDate, toDate);
+
+        res.status(200).json({
+            success: true,
+            data
+        });
+    });
+}
+
+export default DashboardController;
diff --git a/src/interfaces/routes/ownersapp/dashboardRoutes.js b/src/interfaces/routes/ownersapp/dashboardRoutes.js
new file mode 100644
index 0000000..7978929
--- /dev/null
+++ b/src/interfaces/routes/ownersapp/dashboardRoutes.js
@@ -0,0 +1,14 @@
+import express from 'express';
+import DashboardController from '../../controllers/ownersapp/dashboardController.js';
+import DashboardRepo from '../../../infrastructure/repositories/ownersapp/dashboardRepo.js';
+import DashboardUseCase from '../../../usecases/ownersapp/dashboardUseCase.js';
+
+const router = express.Router();
+
+const dashboardRepo = new DashboardRepo();
+const dashboardUseCase = new DashboardUseCase(dashboardRepo);
+const dashboardController = new DashboardController(dashboardUseCase);
+
+router.get('/dashboard', (req, res) => dashboardController.getDashboard(req, res));
+
+export default router;
