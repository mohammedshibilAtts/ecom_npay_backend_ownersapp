@@ -0,0 +1,93 @@
+import schemeAccountModel from "../../models/chit/schemeAccountModel.js";
+
+class SchemeAccountRepo {
+    async getSchemeAccounts(fromDate, toDate) {
+        const now = new Date();
+        const startOfDay = new Date(now.setHours(0, 0, 0, 0));
+        const endOfDay = new Date(now.setHours(0, 0, 0, 0));
+
+        let queryFromDate = startOfDay;
+        if (fromDate && !isNaN(new Date(fromDate).getTime())) {
+            queryFromDate = new Date(fromDate);
+        }
+
+        let queryToDate = endOfDay;
+        if (toDate && !isNaN(new Date(toDate).getTime())) {
+            queryToDate = new Date(toDate);
+        }
+
+        const data = await schemeAccountModel.aggregate([
+            {
+                $match: {
+                    createdAt: { $gte: queryFromDate, $lte: queryToDate },
+                    active: true,
+                    is_deleted: false
+                }
+            },
+            {
+                $lookup: {
+                    from: "payments",
+                    let: { accountId: "$_id" },
+                    pipeline: [
+                        {
+                            $match: {
+                                $expr: { $eq: ["$id_scheme_account", "$$accountId"] },
+                                payment_status: 1,
+                                active: true,
+                                is_deleted: false
+                            }
+                        }
+                    ],
+                    as: "paymentsList"
+                }
+            },
+            {
+                $group: {
+                    _id: null,
+                    totalActiveAccounts: { $sum: 1 },
+                    newAccounts: {
+                        $sum: { $cond: [{ $eq: ["$status", 0] }, 1, 0] }
+                    },
+                    closedAccounts: {
+                        $sum: { $cond: [{ $eq: ["$status", 1] }, 1, 0] }
+                    },
+                    completedAccounts: {
+                        $sum: { $cond: [{ $eq: ["$status", 2] }, 1, 0] }
+                    },
+                    totalPaymentAmount: { $sum: { $sum: "$paymentsList.payment_amount" } },
+                    totalMetalWeight: { $sum: { $sum: "$paymentsList.metal_weight" } }
+                }
+            },
+            {
+                $project: {
+                    _id: 0,
+                    totalActiveAccounts: 1,
+                    newAccounts: 1,
+                    closedAccounts: 1,
+                    completedAccounts: 1,
+                    totalPaymentAmount: 1,
+                    totalMetalWeight: 1
+                }
+            }
+        ]);
+
+        const result = data.length > 0 ? data[0] : {
+            totalActiveAccounts: 0,
+            newAccounts: 0,
+            closedAccounts: 0,
+            completedAccounts: 0,
+            totalPaymentAmount: 0,
+            totalMetalWeight: 0
+        };
+
+        return {
+            dateRange: {
+                fromDate: queryFromDate,
+                toDate: queryToDate
+            },
+            ...result
+        };
+    }
+}
+
+export default SchemeAccountRepo;
diff --git a/src/infrastructure/repositories/ownersapp/schemeRepo.js b/src/infrastructure/repositories/ownersapp/schemeRepo.js
new file mode 100644
index 0000000..3b39ed0
--- /dev/null
+++ b/src/infrastructure/repositories/ownersapp/schemeRepo.js
@@ -0,0 +1,189 @@
+import schemeAccountModel from "../../models/chit/schemeAccountModel.js";
+import paymentModel from "../../models/chit/paymentModel.js";
+import schemeModel from "../../models/chit/schemeModel.js";
+
+class SchemeRepo {
+    async getSchemeCount(query) {
+        try {
+            const filter = { ...query };
+            let startDate, endDate;
+
+            if (filter.fromDate && filter.toDate) {
+                startDate = new Date(filter.fromDate);
+                endDate = new Date(filter.toDate);
+                delete filter.fromDate;
+                delete filter.toDate;
+            } else {
+                startDate = new Date();
+                startDate.setHours(0, 0, 0, 0);
+                endDate = new Date();
+                endDate.setHours(23, 59, 59, 999);
+            }
+
+            const schemeFilter = { ...filter, createdAt: { $gte: startDate, $lte: endDate } };
+            const paymentFilter = { ...filter, createdAt: { $gte: startDate, $lte: endDate }, payment_status: 1 };
+
+            const [schemeStats, paymentStats, activeSchemesCount] = await Promise.all([
+                schemeAccountModel.aggregate([
+                    { $match: schemeFilter },
+                    {
+                        $group: {
+                            _id: null,
+                            newAccounts: {
+                                $sum: 1
+                            },
+                            completedAccounts: {
+                                $sum: { $cond: [{ $eq: ["$status", 2] }, 1, 0] }
+                            }
+                        }
+                    }
+                ]),
+                paymentModel.aggregate([
+                    { $match: paymentFilter },
+                    {
+                        $lookup: {
+                            from: "schemeaccounts",
+                            localField: "id_scheme_account",
+                            foreignField: "_id",
+                            as: "schemeAccount"
+                        }
+                    },
+                    { $unwind: { path: "$schemeAccount", preserveNullAndEmptyArrays: true } },
+                    {
+                        $lookup: {
+                            from: "schemes",
+                            localField: "schemeAccount.id_scheme",
+                            foreignField: "_id",
+                            as: "scheme"
+                        }
+                    },
+                    { $unwind: { path: "$scheme", preserveNullAndEmptyArrays: true } },
+                    {
+                        $lookup: {
+                            from: "metals",
+                            localField: "scheme.id_metal",
+                            foreignField: "_id",
+                            as: "metal"
+                        }
+                    },
+                    { $unwind: { path: "$metal", preserveNullAndEmptyArrays: true } },
+                    {
+                        $group: {
+                            _id: null,
+                            receivedAmount: { $sum: { $ifNull: ["$payment_amount", 0] } },
+                            goldSavings: {
+                                $sum: {
+                                    $cond: [
+                                        { $regexMatch: { input: { $ifNull: ["$metal.metal_name", ""] }, regex: /gold/i } },
+                                        { $ifNull: ["$metal_weight", 0] },
+                                        0
+                                    ]
+                                }
+                            },
+                            silverSavings: {
+                                $sum: {
+                                    $cond: [
+                                        { $regexMatch: { input: { $ifNull: ["$metal.metal_name", ""] }, regex: /silver/i } },
+                                        { $ifNull: ["$metal_weight", 0] },
+                                        0
+                                    ]
+                                }
+                            }
+                        }
+                    }
+                ]),
+                schemeModel.countDocuments({ active: true, is_deleted: false })
+            ]);
+
+            const schemesResult = schemeStats.length > 0 ? schemeStats[0] : { newAccounts: 0, completedAccounts: 0 };
+            const paymentsResult = paymentStats.length > 0 ? paymentStats[0] : { receivedAmount: 0, goldSavings: 0, silverSavings: 0 };
+
+            return {
+                totalActiveSchemes: activeSchemesCount,
+                newAccounts: schemesResult.newAccounts,
+                completedAccounts: schemesResult.completedAccounts,
+                receivedAmount: paymentsResult.receivedAmount,
+                goldSavings: paymentsResult.goldSavings,
+                silverSavings: paymentsResult.silverSavings
+            };
+        } catch (error) {
+            console.error("Error in getSchemeCount repo:", error);
+            throw error;
+        }
+    }
+
+    async getSchemeDetails(query) {
+        try {
+            const filter = { ...query };
+            let startDate, endDate;
+
+            if (filter.fromDate && filter.toDate) {
+                startDate = new Date(filter.fromDate);
+                endDate = new Date(filter.toDate);
+                delete filter.fromDate;
+                delete filter.toDate;
+            }
+
+            const schemeAccountMatch = {
+                active: true,
+                status: 0
+            };
+
+            if (startDate && endDate) {
+                schemeAccountMatch.createdAt = { $gte: startDate, $lte: endDate };
+            }
+
+            const schemeMatch = {
+                ...filter,
+                // active: true,
+                is_deleted: false
+            };
+
+            const result = await schemeModel.aggregate([
+                {
+                    $match: schemeMatch
+                },
+                {
+                    $lookup: {
+                        from: "schemeaccounts",
+                        let: { schemeId: "$_id" },
+                        pipeline: [
+                            {
+                                $match: {
+                                    $expr: { $eq: ["$id_scheme", "$$schemeId"] },
+                                    ...schemeAccountMatch
+                                }
+                            },
+                            {
+                                $count: "activeCount"
+                            }
+                        ],
+                        as: "accounts"
+                    }
+                },
+                {
+                    $addFields: {
+                        totalActiveAccounts: {
+                            $ifNull: [{ $arrayElemAt: ["$accounts.activeCount", 0] }, 0]
+                        }
+                    }
+                },
+                {
+                    $project: {
+                        _id: 1,
+                        scheme_name: 1,
+                        totalActiveAccounts: 1,
+                        active: 1
+                    }
+                }
+            ]);
+
+            return result;
+        } catch (error) {
+            console.error("Error in getSchemeDetails repo:", error);
+            throw error;
+        }
+    }
+}
+
+export default SchemeRepo;
