diff --git a/src/interfaces/controllers/ownersapp/commonController.js b/src/interfaces/controllers/ownersapp/commonController.js
new file mode 100644
index 0000000..7a8aac9
--- /dev/null
+++ b/src/interfaces/controllers/ownersapp/commonController.js
@@ -0,0 +1,28 @@
+import asyncHandler from '../../../utils/errors/asyncHandler.js';
+
+class CommonController {
+    constructor(commonUseCase) {
+        this.commonUseCase = commonUseCase;
+    }
+
+    getGender = asyncHandler(async (req, res) => {
+        try {
+            const data = await this.commonUseCase.getGender();
+            res.status(200).json({ success: true, data });
+        } catch (error) {
+            console.error("Error in getGender controller:", error);
+            res.status(500).json({ success: false, message: error.message || "Internal Server Error" });
+        }
+    });
+    getBranch = asyncHandler(async (req, res) => {
+        try {
+            const data = await this.commonUseCase.getBranch();
+            res.status(200).json({ success: true, data });
+        } catch (error) {
+            console.error("Error in getBranch controller:", error);
+            res.status(500).json({ success: false, message: error.message || "Internal Server Error" });
+        }
+    });
+}
+
+export default CommonController;
diff --git a/src/interfaces/controllers/ownersapp/locationController.js b/src/interfaces/controllers/ownersapp/locationController.js
new file mode 100644
index 0000000..cd8204b
--- /dev/null
+++ b/src/interfaces/controllers/ownersapp/locationController.js
@@ -0,0 +1,44 @@
+import asyncHandler from '../../../utils/errors/asyncHandler.js';
+
+class LocationController {
+    constructor(locationUseCase) {
+        this.locationUseCase = locationUseCase;
+    }
+
+    getCountry = asyncHandler(async (req, res) => {
+        try {
+            const data = await this.locationUseCase.getCountry();
+            res.status(200).json({ success: true, data });
+        } catch (error) {
+            console.error("Error in getCountry controller:", error);
+            res.status(500).json({ success: false, message: error.message || "Internal Server Error" });
+        }
+    });
+
+    getState = asyncHandler(async (req, res) => {
+        try {
+            const { id } = req.query;
+            const data = await this.locationUseCase.getState(id);
+            res.status(200).json({ success: true, data });
+        } catch (error) {
+            console.error("Error in getState controller:", error);
+            res.status(500).json({ success: false, message: error.message || "Internal Server Error" });
+        }
+    });
+
+    getCity = asyncHandler(async (req, res) => {
+        try {
+            const { id } = req.query;
+            if (!id) {
+                return res.status(400).json({ success: false, message: "State ID is required" });
+            }
+            const data = await this.locationUseCase.getCity(id);
+            res.status(200).json({ success: true, data });
+        } catch (error) {
+            console.error("Error in getCity controller:", error);
+            res.status(500).json({ success: false, message: error.message || "Internal Server Error" });
+        }
+    });
+}
+
+export default LocationController;
