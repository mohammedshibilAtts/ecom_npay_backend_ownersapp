+                let onlineAmount = 0;
+                let cashAmount = 0;
+                let otherAmount = 0;
+                let offlineAmount = 0;
+
+                const rawModes = data[0].modeWise || [];
+                rawModes.forEach(mode => {
+                    const idMode = Number(mode.id_mode);
